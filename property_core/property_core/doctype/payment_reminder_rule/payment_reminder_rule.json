      "reqd": 1,
      "columns": 2,
      "description": "Shown in the notification log, e.g. '3 days before due'"
    },
    {
      "fieldname": "offset_days",
      "fieldtype": "Int",
      "in_list_view": 1,
      "label": "Offset Days",
      "columns": 1,
      "description": "Days relative to the invoice due date. Negative = before due (-3 = 3 days before), 0 = on the due date, positive = after due."
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "repeat_after_offset",
      "fieldtype": "Check",
      "in_list_view": 1,
      "label": "Repeat",
      "columns": 1,
      "description": "Keep reminding after the offset day until the invoice is paid"
    },
    {
      "fieldname": "repeat_every_days",
      "fieldtype": "Int",
      "in_list_view": 1,
      "label": "Repeat Every (Days)",
      "columns": 1,
      "depends_on": "repeat_after_offset",
      "description": "Interval between repeats, e.g. 7 = weekly"
    },
    {
      "fieldname": "stop_after_days",
      "fieldtype": "Int",
      "label": "Stop After (Days)",
      "depends_on": "repeat_after_offset",
      "description": "Stop repeating this many days past the due date. 0 = never stop (until paid)."
